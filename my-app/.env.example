# Cloudinary (frontend-safe variables only)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

# Optional
# VITE_FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com

# Shared product sync mode: mongodb | firebase | local
VITE_PRODUCTS_SYNC_MODE=mongodb

# Optional for production/staging API host. Leave empty in local dev to use Vite proxy (/api)
VITE_PRODUCTS_API_BASE_URL=

# Local MongoDB API server
API_PORT=4000
MONGODB_URI=
MONGODB_USERNAME=your_mongodb_username
MONGODB_PASSWORD=your_mongodb_password
MONGODB_CLUSTER_HOST=your-cluster.mongodb.net
MONGODB_OPTIONS=retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB_NAME=click_call_db
MONGODB_COLLECTION=products
